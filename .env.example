# Database Configuration
# Default: Local SQLite database for zero-dependency development and testing
DATABASE_URL=sqlite:///pipeline.db

# Production PostgreSQL Configuration (Optional - replace password if using PostgreSQL)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/notification_pipeline

# Pipeline Execution Settings
PIPELINE_MODE=DRY_RUN      # Choices: DRY_RUN, REDIRECTED, COHORT, PROD
REDIRECT_TEST_EMAIL=akshaychavan20031@gmail.com

# API Simulation vs Live Mode
USE_MOCK_APIS=true

# Google API Credentials (when USE_MOCK_APIS=false)
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# YOUTUBE_API_KEY=your_youtube_api_key
